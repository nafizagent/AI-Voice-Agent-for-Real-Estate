    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\n\nconst titles    = input.title    || [];\nconst prices    = input.price    || [];\nconst locations = input.location || [];\nconst types     = input.type     || [];\nconst beds      = input.beds     || [];\nconst baths     = input.baths    || [];\nconst sqfts     = input.sqft     || [];\nconst links     = input.link     || [];\n\nreturn titles.map((title, i) => {\n  const price = prices[i] || '';\n  const link  = links[i]  || '';\n  return {\n    json: {\n      title:       title?.trim() || '',\n      price_text:  price.trim(),\n      price_num:   parseInt(price.replace(/[^0-9]/g, '')) || 0,\n      location:    locations[i]?.replace('📍','').trim() || '',\n      city:        locations[i]?.replace('📍','').split(',')[0].trim() || '',\n      type:        types[i]?.trim() || '',\n      beds:        parseInt((beds[i]||'').replace(/[^0-9]/g,'')) || 0,\n      baths:       parseInt((baths[i]||'').replace(/[^0-9]/g,'')) || 0,\n      sqft:        parseInt((sqfts[i]||'').replace(/[^0-9]/g,'')) || 0,\n      detail_url:  'https://primenestgo.netlify.app' + link,\n      scraped_at:  new Date().toISOString()\n    }\n  };\n});"
      },
